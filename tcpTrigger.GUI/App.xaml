<Application x:Class="tcpTrigger.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WindowChrome.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/BadgeStyle.xaml"/>
                <ResourceDictionary Source="Themes/ButtonStyle.xaml"/>
                <ResourceDictionary Source="Themes/ComboBoxStyle.xaml"/>
                <ResourceDictionary Source="Themes/Converters.xaml"/>
                <ResourceDictionary Source="Themes/CheckBoxStyle.xaml"/>
                <ResourceDictionary Source="Themes/DataGridStyle.xaml"/>
                <ResourceDictionary Source="Themes/InfoBoxStyle.xaml"/>
                <ResourceDictionary Source="Themes/MenuItemStyle.xaml"/>
                <ResourceDictionary Source="Themes/ScrollBarStyle.xaml"/>
                <ResourceDictionary Source="Themes/ScrollViewerStyle.xaml"/>
                <ResourceDictionary Source="Themes/TabControlStyle.xaml"/>
                <ResourceDictionary Source="Themes/TextBlockStyle.xaml"/>
                <ResourceDictionary Source="Themes/TextBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>