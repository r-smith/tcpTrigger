<Window x:Class="tcpTrigger.GUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tcpTrigger Settings"
        Height="560"
        Width="740"
        MinHeight="300"
        MinWidth="500"
        Closing="Window_Closing"
        Closed="Window_Closed"
        MouseDown="Window_MouseDown"
        ShowInTaskbar="True"
        Background="{StaticResource Window.Background}">

    <Grid>
        <!-- Window content -->
        <Grid IsEnabled="{Binding Visibility, ElementName=DialogOverlay, Converter={StaticResource VisibleToDisabled}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tab control -->
            <TabControl Style="{StaticResource TabControlVerticalStyle}"
                        x:Name="MyTabControl"
                        TabStripPlacement="Left"
                        Background="Transparent"
                        HorizontalContentAlignment="Left"
                        Margin="0,5,0,0">
                <TabItem x:Name="TabDetect" Style="{StaticResource TabItemVerticalStyle}" Header="Detect">
                    <ContentControl x:Name="DetectContent" Focusable="False"/>
                </TabItem>
                <TabItem x:Name="TabNotify" Style="{StaticResource TabItemVerticalStyle}" Header="Notify">
                    <ContentControl x:Name="NotifyContent" Focusable="False"/>
                </TabItem>
                <TabItem x:Name="TabIgnore" Style="{StaticResource TabItemVerticalStyle}" Header="Ignore">
                    <ContentControl x:Name="IgnoreContent" Focusable="False"/>
                </TabItem>
                <TabItem x:Name="TabStatus" Style="{StaticResource TabItemVerticalStyle}" Header="Status">
                    <ContentControl x:Name="StatusContent" Focusable="False"/>
                </TabItem>
            </TabControl>

            <!-- Button section -->
            <Border Grid.Row="1" Background="{StaticResource ButtonBar.Background}" BorderBrush="{StaticResource ButtonBar.Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="25,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SaveButton"
                                Content="Save"
                                IsEnabled="False"
                                Click="Save_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Close"
                                Click="Close_Click"
                                Style="{StaticResource SecondaryButton}"
                                IsCancel="True"/>
                    </StackPanel>
                    <!-- Unsaved changes, or the result of the last save -->
                    <TextBlock x:Name="SaveStatus"
                               FontSize="14"
                               Foreground="{StaticResource SaveStatus.Normal}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,15,0"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Dialog overlay -->
        <UserControl x:Name="DialogOverlay"
                     Visibility="Collapsed"/>
    </Grid>
</Window>
