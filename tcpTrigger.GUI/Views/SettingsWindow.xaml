<Window x:Class="tcpTrigger.GUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tcpTrigger Settings"
        Height="580"
        Width="740"
        MinHeight="300"
        MinWidth="500"
        Closing="Window_Closing"
        Closed="Window_Closed"
        MouseDown="Window_MouseDown"
        ShowInTaskbar="True"
        Background="#000000"
        WindowStyle="None">

    <Window.Resources>
        <SolidColorBrush x:Key="SaveStatus.Normal" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="SaveStatus.Warning" Color="#FFD43B"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource WindowMainPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Window title bar -->
            <Grid Grid.Row="0" Background="#000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <!-- Dim title bar elements when window loses focus -->
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Icon -->
                <Image Grid.Column="0"
                       Width="20"
                       Height="20"
                       Margin="8,0,4,0"
                       Source="{StaticResource icon.tcpTrigger}"/>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource TitleBar.Static.Foreground}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

                <!-- Minimize button -->
                <Button Grid.Column="2"
                        Click="Minimize_Click"
                        RenderOptions.EdgeMode="Aliased"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="Minimize">
                    <Path Width="46"
                          Height="29"
                          Data="M 18,15 H 28"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1"/>
                </Button>

                <!-- Maximize button -->
                <Grid Grid.Column="3">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <!-- The maximize button collapses when the window is maximized -->
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Button Click="MaximizeRestore_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Maximize">
                        <Path Width="46"
                              Height="31"
                              Data="M 18.5,10.5 H 27.5 V 19.5 H 18.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"/>
                    </Button>
                </Grid>

                <!-- Restore button -->
                <Grid Grid.Column="3">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <!-- The restore button is visible only when the window is maximized -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Button Click="MaximizeRestore_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Restore">
                        <Path Width="46"
                              Height="31"
                              Data="M 18.5,12.5 H 25.5 V 19.5 H 18.5 Z M 20.5,12.5 V 10.5 H 27.5 V 17.5 H 25.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"/>
                    </Button>
                </Grid>

                <!-- Close button -->
                <Button Grid.Column="4"
                        Click="Close_Click"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        ToolTip="Close">
                    <Path Width="46"
                          Height="31"
                          Data="M 18,11 27,20 M 18,20 27,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1"/>
                </Button>
            </Grid>

            <!-- Window content -->
            <Grid Grid.Row="1" IsEnabled="{Binding Visibility, ElementName=DialogOverlay, Converter={StaticResource VisibleToDisabled}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tab control -->
                <TabControl Style="{StaticResource TabControlVerticalStyle}"
                            x:Name="MyTabControl"
                            TabStripPlacement="Left"
                            Background="Transparent"
                            HorizontalContentAlignment="Left"
                            Margin="0,5,0,0">
                    <TabItem x:Name="TabDetect" Style="{StaticResource TabItemVerticalStyle}" Header="Detect">
                        <ContentControl x:Name="DetectContent" Focusable="False"/>
                    </TabItem>
                    <TabItem x:Name="TabNotify" Style="{StaticResource TabItemVerticalStyle}" Header="Notify">
                        <ContentControl x:Name="NotifyContent" Focusable="False"/>
                    </TabItem>
                    <TabItem x:Name="TabIgnore" Style="{StaticResource TabItemVerticalStyle}" Header="Ignore">
                        <ContentControl x:Name="IgnoreContent" Focusable="False"/>
                    </TabItem>
                    <TabItem x:Name="TabStatus" Style="{StaticResource TabItemVerticalStyle}" Header="Status">
                        <ContentControl x:Name="StatusContent" Focusable="False"/>
                    </TabItem>
                </TabControl>

                <!-- Button section -->
                <Border Grid.Row="1" Background="#141517" BorderBrush="#303030" BorderThickness="0,1,0,0">
                    <DockPanel Margin="25">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="SaveButton"
                                    Content="Save"
                                    IsEnabled="False"
                                    Click="Save_Click"
                                    Width="110"
                                    Margin="0,0,10,0"/>
                            <Button Content="Close"
                                    Click="Close_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    IsCancel="True"
                                    Width="110"/>
                        </StackPanel>
                        <!-- Unsaved changes, or the result of the last save -->
                        <TextBlock x:Name="SaveStatus"
                                   FontSize="14"
                                   Foreground="{StaticResource SaveStatus.Normal}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,15,0"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Dialog overlay -->
            <UserControl x:Name="DialogOverlay"
                         Grid.RowSpan="2"
                         Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>