<local:EditorWindow x:Class="tcpTrigger.GUI.Views.IgnoreCreateWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:tcpTrigger.GUI.Views"
                    Title="New ignore rule"
                    Height="640"
                    Width="690"
                    MinHeight="450"
                    MinWidth="500"
                    MouseDown="Window_MouseDown"
                    ShowInTaskbar="False"
                    Background="{StaticResource Window.Background}"
                    WindowStartupLocation="CenterOwner"
                    FontSize="14">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Window content -->
        <Grid IsEnabled="{Binding Visibility, ElementName=DialogOverlay, Converter={StaticResource VisibleToDisabled}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ignore rule content -->
            <Border Background="{StaticResource Window.Background}"
                    Margin="0,20,0,0">
                <ContentControl x:Name="IgnoreRuleContent"
                                Focusable="False"/>
            </Border>

            <!-- Button section -->
            <Border Grid.Row="1" Background="{StaticResource ButtonBar.Background}" BorderBrush="{StaticResource ButtonBar.Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="0,14,25,14" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="_Add"
                                Click="Add_Click"
                                HorizontalAlignment="Right"
                                Width="110"
                                Margin="0,0,10,0"/>
                        <Button Content="Cancel"
                                Click="Cancel_Click"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButton}"
                                Width="110"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Dialog overlay -->
        <UserControl x:Name="DialogOverlay"
                     Visibility="Collapsed"/>
    </Grid>
</local:EditorWindow>
