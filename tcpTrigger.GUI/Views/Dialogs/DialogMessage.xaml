<UserControl x:Class="tcpTrigger.GUI.Views.Dialogs.DialogMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             UseLayoutRounding="True">
    <Grid Background="{StaticResource Dialog.Overlay}">
        <ContentControl Style="{StaticResource DialogBox}" BorderBrush="{StaticResource Dialog.Accent}">
            <StackPanel>
                <TextBlock x:Name="Heading"
                           d:Text="Error"
                           Style="{StaticResource DialogHeading}"/>
                <TextBlock x:Name="Message"
                           d:Text="A message goes here."
                           MinWidth="270"
                           MaxWidth="420"
                           Style="{StaticResource DialogMessage}"/>
                <StackPanel Style="{StaticResource DialogButtons}">
                    <!-- Shown when the dialog is given text to copy -->
                    <Button x:Name="CopyButton"
                            Content="_Copy"
                            Style="{StaticResource SecondaryButton}"
                            Click="Copy_Click"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="OkButton"
                            Content="OK"
                            Click="OK_Click"
                            IsCancel="True"
                            IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
