<UserControl x:Class="tcpTrigger.GUI.Views.Dialogs.DialogMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             UseLayoutRounding="True">
    <Grid Background="#88000000">
        <Border Background="#181818"
                CornerRadius="4"
                Padding="25"
                BorderBrush="#9184EE"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="Heading"
                           d:Text="Error"
                           FontSize="19"
                           FontFamily="Segoe UI"
                           FontWeight="Regular"
                           Foreground="#FFFFFF"/>
                <TextBlock x:Name="Message"
                           d:Text="A message goes here."
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           MinWidth="270"
                           MaxWidth="420"
                           FontSize="14"
                           HorizontalAlignment="Left"
                           Foreground="#FFFFFF"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,45,0,0">
                    <!-- Shown when the dialog is given text to copy -->
                    <Button x:Name="CopyButton"
                            Content="_Copy"
                            Style="{StaticResource SecondaryButton}"
                            Click="Copy_Click"
                            Width="130"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="OkButton"
                            Content="OK"
                            Click="OK_Click"
                            IsCancel="True"
                            IsDefault="True"
                            Width="130"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>