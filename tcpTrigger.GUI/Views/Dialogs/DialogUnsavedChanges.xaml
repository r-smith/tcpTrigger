<UserControl x:Class="tcpTrigger.GUI.Views.Dialogs.DialogUnsavedChanges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:Width="600" d:Height="500"
             UseLayoutRounding="True">
    <Grid Background="{StaticResource Dialog.Overlay}">
        <ContentControl Style="{StaticResource DialogBox}" BorderBrush="{StaticResource Dialog.Warning.Accent}">
            <StackPanel>
                <!-- Heading and message -->
                <Border Style="{StaticResource DialogBody}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource DialogIcon}"
                                            Tag="{StaticResource WarningIcon}"
                                            Foreground="{StaticResource Dialog.Warning.Accent}"/>
                            <TextBlock Text="Save changes?"
                                       Style="{StaticResource DialogHeading}"/>
                        </StackPanel>
                        <TextBlock Text="Your changes to tcpTrigger haven't been saved."
                                   Style="{StaticResource DialogMessage}"/>
                    </StackPanel>
                </Border>
                <!-- Buttons -->
                <Border Style="{StaticResource DialogFooter}">
                    <StackPanel Style="{StaticResource DialogButtons}">
                        <Button x:Name="SaveButton"
                                Content="_Save"
                                Click="Save_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Do_n't save"
                                Style="{StaticResource SecondaryButton}"
                                Click="DontSave_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Click="Cancel_Click"
                                IsCancel="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
