<UserControl x:Class="tcpTrigger.GUI.Views.Dialogs.DialogStopService"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:Width="600" d:Height="500"
             UseLayoutRounding="True">
    <Grid Background="#88000000">
        <Border Background="#181818"
                CornerRadius="4"
                Padding="25"
                BorderBrush="#FFD43B"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Stop monitoring?"
                           FontSize="19"
                           FontFamily="Segoe UI"
                           FontWeight="Regular"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="tcpTrigger won't detect anything until the service is started again."
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           FontSize="14"
                           HorizontalAlignment="Left"
                           Foreground="#FFFFFF"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,45,0,0">
                    <Button Click="Stop_Click"
                            Width="150"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Shield icon -->
                            <Viewbox Width="14"
                                     Height="14"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,3 L19,6 L19,11 C19,15.5 16,19 12,21 C8,19 5,15.5 5,11 L5,6 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <AccessText Text="_Stop service"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"
                            IsCancel="True"
                            Width="130"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>