<UserControl x:Class="tcpTrigger.GUI.Views.Dialogs.DialogStopService"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:Width="600" d:Height="500"
             UseLayoutRounding="True">
    <Grid Background="{StaticResource Dialog.Overlay}">
        <Border Background="{StaticResource Dialog.Background}"
                CornerRadius="4"
                Padding="25"
                BorderBrush="{StaticResource Dialog.Warning.Border}"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Stop monitoring?"
                           FontSize="19"
                           FontFamily="Segoe UI"
                           FontWeight="Regular"
                           Foreground="{StaticResource Dialog.Foreground}"/>
                <TextBlock Text="tcpTrigger won't detect anything until the service is started again."
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           FontSize="14"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource Dialog.Foreground}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,45,0,0">
                    <Button Click="Stop_Click"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Shield icon -->
                            <Image Source="{StaticResource icon.shield}"
                                   Width="14"
                                   Height="14"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                            <AccessText Text="_Stop service"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"
                            IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
