<UserControl x:Class="tcpTrigger.GUI.Views.Dialogs.DialogRuleDelete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:tcpTrigger.GUI.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=models:Notification}"
             d:Width="500" d:Height="500"
             UseLayoutRounding="True">
    <Grid Background="{StaticResource Dialog.Overlay}">
        <ContentControl Style="{StaticResource DialogBox}" BorderBrush="{StaticResource Dialog.Danger.Border}">
            <StackPanel>
                <TextBlock Text="Confirm delete"
                           Style="{StaticResource DialogHeading}"/>
                <TextBlock Width="270"
                           MaxHeight="100"
                           TextTrimming="WordEllipsis"
                           Style="{StaticResource DialogMessage}">
                    <Run Foreground="{StaticResource Dialog.RuleName.Foreground}" d:Text="-{xxx}-" Text="{Binding Name}"/>
                    <Run Text="will be deleted when you save settings."/>
                </TextBlock>
                <StackPanel Style="{StaticResource DialogButtons}">
                    <Button Content="_Delete"
                            Style="{StaticResource DangerButton}"
                            Click="Delete_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"
                            IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
