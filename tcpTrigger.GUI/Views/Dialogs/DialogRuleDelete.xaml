<UserControl x:Class="tcpTrigger.GUI.Views.Dialogs.DialogRuleDelete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:tcpTrigger.GUI.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=models:Notification}"
             d:Width="500" d:Height="500"
             UseLayoutRounding="True">
    <Grid Background="#88000000">
        <Border Background="#181818"
                CornerRadius="4"
                Padding="25"
                BorderBrush="#FD005C"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Confirm delete"
                           FontSize="19"
                           FontFamily="Segoe UI"
                           FontWeight="Regular"
                           Foreground="#FFFFFF"/>
                <TextBlock TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Width="270"
                           MaxHeight="100"
                           TextTrimming="WordEllipsis"
                           FontSize="14"
                           HorizontalAlignment="Left"
                           Foreground="#FFFFFF">
                    <Run Foreground="#FFFFAA" d:Text="-{xxx}-" Text="{Binding Name}"/>
                    <Run Text="will be deleted when you save settings."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,45,0,0">
                    <Button Content="_Delete"
                            Style="{StaticResource DangerButton}"
                            Click="Delete_Click"
                            Width="130"
                            Margin="0,0,10,0"/>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"
                            IsCancel="True"
                            Width="130"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>