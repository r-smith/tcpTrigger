<UserControl x:Class="tcpTrigger.GUI.Views.Controls.VariablePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A "Show variables" link that opens a list of variables. Clicking a variable raises
         VariableClicked, and the editor inserts it into the right text box. -->
    <StackPanel>
        <!-- Show or hide the variables -->
        <ToggleButton x:Name="ShowToggle"
                      Style="{StaticResource LinkToggleButton}"
                      HorizontalAlignment="Left"
                      Margin="-4,0,0,0"
                      Checked="ShowToggle_Changed"
                      Unchecked="ShowToggle_Changed"/>

        <!-- Variables -->
        <StackPanel Visibility="{Binding IsChecked, ElementName=ShowToggle, Converter={StaticResource TrueToVisible}}">
            <TextBlock x:Name="HintText"
                       Style="{StaticResource HintText}"
                       Margin="0,6,0,0"/>
            <WrapPanel x:Name="VariableButtons" Margin="0,6,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
