<local:EditorWindow x:Class="tcpTrigger.GUI.Views.NotifyEditWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:tcpTrigger.GUI.Views"
                    mc:Ignorable="d"
                    Title="Edit notification"
                    Height="690"
                    Width="640"
                    MinHeight="300"
                    MinWidth="500"
                    MouseDown="Window_MouseDown"
                    ShowInTaskbar="False"
                    Background="{StaticResource Window.Background}"
                    WindowStartupLocation="CenterOwner"
                    FontSize="14">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Window content -->
        <Grid IsEnabled="{Binding Visibility, ElementName=DialogOverlay, Converter={StaticResource VisibleToDisabled}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Orientation="Horizontal" Margin="25,12,25,0">
                <Image Width="24"
                       Height="24"
                       Source="{StaticResource icon.megaphone}"/>
                <TextBlock Margin="15,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource EditorTitle.Foreground}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="60,25,25,0" Orientation="Horizontal">
                <TextBlock Text="Notification type:"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource NotificationType.Label.Foreground}"
                           Margin="0,15,0,1"/>
                <TextBlock x:Name="NotificationTypeText"
                           d:Text="Email"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource NotificationType.Foreground}"
                           Margin="6,15,0,1"/>
            </StackPanel>

            <!-- Notification content. Changes based on selected notification type. -->
            <Border Grid.Row="2"
                    Background="{StaticResource Window.Background}"
                    Margin="0,25,0,0">
                <ContentControl x:Name="NotificationEntryControl"
                                Focusable="False"/>
            </Border>

            <!-- Button section -->
            <Border Grid.Row="3" Background="{StaticResource ButtonBar.Background}" BorderBrush="{StaticResource ButtonBar.Border}" BorderThickness="0,1,0,0">
                <Grid Margin="25,20,25,20">
                    <Button x:Name="DeleteButton"
                            Style="{StaticResource DeleteButton}"
                            HorizontalAlignment="Left"
                            Click="Delete_Click"
                            Tag="{Binding}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="_OK"
                                Click="OK_Click"
                                HorizontalAlignment="Right"
                                Width="110"
                                Margin="0,0,10,0"/>
                        <Button Content="Cancel"
                                Click="Cancel_Click"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButton}"
                                Width="110"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Dialog overlay -->
        <UserControl x:Name="DialogOverlay"
                     Visibility="Collapsed"/>
    </Grid>
</local:EditorWindow>
