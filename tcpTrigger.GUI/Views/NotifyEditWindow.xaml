<local:EditorWindow x:Class="tcpTrigger.GUI.Views.NotifyEditWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:tcpTrigger.GUI.Views"
                    mc:Ignorable="d"
                    Title="Edit notification"
                    Height="690"
                    Width="640"
                    MinHeight="300"
                    MinWidth="500"
                    MouseDown="Window_MouseDown"
                    ShowInTaskbar="False"
                    Background="#000000"
                    WindowStyle="None"
                    WindowStartupLocation="CenterOwner"
                    FontSize="14">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowMainPanelStyle}" BorderBrush="#707070" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Window title bar -->
            <Grid Grid.Row="0" Background="#000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <!-- Dim title bar elements when window loses focus -->
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Icon -->
                <Image Grid.Column="0"
                       Width="28"
                       Height="28"
                       Margin="25,12,0,0"
                       Source="{StaticResource icon.megaphone}"
                       HorizontalAlignment="Left"/>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Margin="15,12,0,0"
                           VerticalAlignment="Center"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Left"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

                <!-- Close button -->
                <Button Grid.Column="2"
                        Click="Close_Click"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        ToolTip="Close">
                    <Path Width="46"
                          Height="31"
                          Data="M 18,11 27,20 M 18,20 27,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1"/>
                </Button>
            </Grid>

            <!-- Window content -->
            <Grid Grid.Row="1"
                  IsEnabled="{Binding Visibility, ElementName=DialogOverlay, Converter={StaticResource VisibleToDisabled}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="60,25,25,0" Orientation="Horizontal">
                    <TextBlock Text="Notification type:"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#666666"
                               Margin="0,15,0,1"/>
                    <TextBlock x:Name="NotificationTypeText"
                               d:Text="Email"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#AAAAAA"
                               Margin="6,15,0,1"/>
                </StackPanel>

                <!-- Notification content. Changes based on selected notification type. -->
                <Border Grid.Row="1"
                        Background="#000000"
                        Margin="0,25,0,0">
                    <ContentControl x:Name="NotificationEntryControl"
                                    Focusable="False"/>
                </Border>

                <!-- Button section -->
                <Border Grid.Row="2" Background="#141517" BorderBrush="#303030" BorderThickness="0,1,0,0">
                    <Grid Margin="25,20,25,20">
                        <Button x:Name="DeleteButton"
                                Style="{StaticResource DeleteButton}"
                                HorizontalAlignment="Left"
                                Click="Delete_Click"
                                Tag="{Binding}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="_OK"
                                    Click="OK_Click"
                                    HorizontalAlignment="Right"
                                    Width="110"
                                    Margin="0,0,10,0"/>
                            <Button Content="Cancel"
                                    Click="Cancel_Click"
                                    IsCancel="True"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="110"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Dialog overlay -->
            <UserControl x:Name="DialogOverlay"
                         Grid.RowSpan="2"
                         Visibility="Collapsed"/>
        </Grid>
    </Border>
</local:EditorWindow>