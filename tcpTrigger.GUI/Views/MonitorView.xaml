<UserControl x:Class="tcpTrigger.GUI.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:tcpTrigger.GUI.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Detailed view cells: only the cell's text, with no selection or focus look -->
        <Style x:Key="DetailedCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Detailed view text. The left padding lines it up with its column header. -->
        <Style x:Key="DetailedText" TargetType="{x:Type TextBlock}">
            <Setter Property="Padding" Value="5,4,20,4"/>
        </Style>

        <!-- Detailed view ports. ICMP has no ports, so they're left blank instead of showing 0. -->
        <Style x:Key="DetailedPort" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DetailedText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="ICMP">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar. Opened with Ctrl+F or the search button -->
        <Border x:Name="FilterBar"
                Visibility="Collapsed"
                BorderBrush="#262B3A"
                BorderThickness="0,0,0,1"
                Padding="5,0,0,8"
                Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <Grid DockPanel.Dock="Left" Width="240">
                    <TextBox x:Name="FilterBox"
                             FontFamily="Consolas"
                             FontSize="14"
                             Padding="24,2,3,2"
                             TextChanged="FilterBox_TextChanged"
                             PreviewKeyDown="FilterBox_PreviewKeyDown"
                             AutomationProperties.Name="Filter detections"/>
                    <!-- Magnifier icon -->
                    <Path Stroke="#959AAE"
                          StrokeThickness="1.6"
                          Margin="8,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Path.Data>
                            <GeometryGroup>
                                <EllipseGeometry Center="5.5,5.5" RadiusX="4.5" RadiusY="4.5"/>
                                <LineGeometry StartPoint="9,9" EndPoint="13,13"/>
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                    <!-- Placeholder text -->
                    <TextBlock Text="Filter"
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="#707070"
                               Margin="28,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- How many detections matched the filter. Empty while there's no filter. -->
                <TextBlock x:Name="FilterCount"
                           FontSize="13"
                           Foreground="#959AAE"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>

                <!-- Close filter button -->
                <Button DockPanel.Dock="Right"
                        Width="26"
                        Height="26"
                        Click="CloseFilter_Click"
                        ToolTip="Close (Esc)"
                        AutomationProperties.Name="Close filter"
                        Cursor="Hand"
                        FocusVisualStyle="{StaticResource SmallButtonFocusVisual}">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="HoverBackground" Background="Transparent" CornerRadius="3">
                                <Path Data="M 0,0 L 9,9 M 0,9 L 9,0"
                                      Stroke="#A0A0A0"
                                      StrokeThickness="1.5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverBackground" Property="Background" Value="#202020"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Border>

        <!-- Datagrid for detection events -->
        <DataGrid x:Name="Log"
                  Grid.Row="1"
                  FontSize="16"
                  Style="{StaticResource DataGridStyle}"
                  ContextMenuOpening="Log_ContextMenuOpening"
                  PreviewMouseLeftButtonDown="Log_PreviewMouseLeftButtonDown"
                  PreviewKeyDown="Log_PreviewKeyDown">
            <!-- Row style -->
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource DataGridRowStyle}">
                    <Setter Property="DetailsVisibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- ShowDetails is toggled by left click -->
                        <DataTrigger Binding="{Binding ShowDetails}" Value="True">
                            <Setter Property="DetailsVisibility" Value="Visible"/>
                            <Setter Property="Background" Value="{StaticResource DG.Row.Selected.Background}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <!-- Row details style (full source and destination), toggled by left click -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Columns[0].ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Endpoints}"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   Foreground="#2EDCDC"
                                   Padding="20,6,0,6"/>
                    </Grid>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.ContextMenu>
                <ContextMenu Closed="LogMenu_Closed">
                    <MenuItem Header="Copy source IP" Click="CopySourceIP_Click"/>
                    <MenuItem Header="Copy event details" Click="CopyEventDetails_Click"/>
                    <MenuItem x:Name="LookupHostnameItem" Header="Look up hostname" Click="LookupHostname_Click"/>
                    <Separator/>
                    <MenuItem x:Name="IgnoreSourceItem" Header="Ignore this source..." Click="IgnoreSource_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- Timestamp: shown in both views -->
                <DataGridTextColumn Binding="{Binding Timestamp}" Header="Time">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Timestamp, StringFormat=d}"
                                                       Foreground="#A0A0A0"
                                                       Padding="5,4,0,4"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=T}"
                                                       Foreground="#E0E0E0"
                                                       Padding="0,4,5,4"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- Compact view: source IP -->
                <DataGridTextColumn x:Name="CompactSourceColumn" Binding="{Binding SourceIP}" Header="Source">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceIP}"
                                                       FontFamily="Consolas"
                                                       Foreground="#FFD43B"
                                                       FontSize="18"
                                                       Padding="20,4,10,4"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- Compact view: destination -->
                <DataGridTextColumn x:Name="CompactPortColumn" Binding="{Binding DestinationPort}" Header="Port">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="#707070"
                                                       Padding="5,4,4,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="connected to port"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="UDP">
                                                                <Setter Property="Text" Value="sent UDP data to port"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="ICMP">
                                                                <Setter Property="Text" Value="pinged this computer"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DestinationPort}"
                                                       Foreground="#61B8FF"
                                                       FontFamily="Consolas"
                                                       FontSize="18"
                                                       Padding="6,4,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DestinationPort}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- The port's name, if it's a well-known port -->
                                            <TextBlock Text="{Binding PortName}"
                                                       Foreground="#B84DB8"
                                                       FontFamily="Consolas"
                                                       FontSize="14"
                                                       Padding="12,5,0,4"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- Detailed view: one column per field -->
                <DataGridTextColumn x:Name="DetailedSourceIPColumn"
                                    Header="Source IP"
                                    Binding="{Binding SourceIP}"
                                    Width="Auto"
                                    Visibility="Collapsed"
                                    FontFamily="Consolas"
                                    Foreground="#FFD43B"
                                    CellStyle="{StaticResource DetailedCell}"
                                    ElementStyle="{StaticResource DetailedText}"/>
                <DataGridTextColumn x:Name="DetailedDestinationIPColumn"
                                    Header="Destination IP"
                                    Binding="{Binding DestinationIP}"
                                    Width="Auto"
                                    Visibility="Collapsed"
                                    FontFamily="Consolas"
                                    Foreground="#999999"
                                    CellStyle="{StaticResource DetailedCell}"
                                    ElementStyle="{StaticResource DetailedText}"/>
                <DataGridTextColumn x:Name="DetailedDestinationPortColumn"
                                    Header="Destination port"
                                    Binding="{Binding DestinationPort}"
                                    Width="144"
                                    Visibility="Collapsed"
                                    FontFamily="Consolas"
                                    Foreground="#61B8FF"
                                    CellStyle="{StaticResource DetailedCell}"
                                    ElementStyle="{StaticResource DetailedPort}"/>
                <DataGridTextColumn x:Name="DetailedServiceColumn"
                                    Header="Service"
                                    Binding="{Binding PortName, Mode=OneWay}"
                                    Width="Auto"
                                    Visibility="Collapsed"
                                    FontFamily="Consolas"
                                    Foreground="#B84DB8"
                                    CellStyle="{StaticResource DetailedCell}"
                                    ElementStyle="{StaticResource DetailedText}"/>
                <DataGridTextColumn x:Name="DetailedProtocolColumn"
                                    Header="Protocol"
                                    Binding="{Binding Type}"
                                    Width="Auto"
                                    Visibility="Collapsed"
                                    Foreground="#A0A0A0"
                                    CellStyle="{StaticResource DetailedCell}"
                                    ElementStyle="{StaticResource DetailedText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Overlay when the list is empty: no detections, or nothing matches the filter -->
        <Border Grid.Row="1" Background="#000000">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count, ElementName=Log}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="EmptyTitle"
                           Text="No events"
                           Foreground="#FFD43B"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"
                           FontSize="36"/>
                <TextBlock x:Name="EmptyMessage"
                           Text="When another device tries to reach this computer, it shows up here."
                           Foreground="#E8E8E8"
                           FontSize="16"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Overlay when initial event loading is in progress -->
        <Border x:Name="LoadingOverlay" Grid.Row="1" Background="#000000">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <DockPanel>
                    <controls:Spinner Foreground="#61B8FF"
                                      DockPanel.Dock="Top"
                                      HorizontalAlignment="Center"/>
                    <TextBlock Text="Loading tcpTrigger detection history..."
                               DockPanel.Dock="Top"
                               Foreground="#CCCCCC"
                               Margin="0,15,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Normal"
                               FontSize="18"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>