<local:EditorWindow x:Class="tcpTrigger.GUI.Views.IgnoreExportWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:tcpTrigger.GUI.Views"
                    Title="Export ignore rules"
                    Height="500"
                    Width="650"
                    MinHeight="350"
                    MinWidth="500"
                    MouseDown="Window_MouseDown"
                    ShowInTaskbar="False"
                    Background="{StaticResource Window.Background}"
                    WindowStartupLocation="CenterOwner"
                    FontSize="14">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Window content -->
        <Grid IsEnabled="{Binding Visibility, ElementName=DialogOverlay, Converter={StaticResource VisibleToDisabled}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Select all, and how many are selected -->
            <DockPanel Margin="25,20,25,8">
                <TextBlock x:Name="SelectedCount"
                           DockPanel.Dock="Right"
                           Style="{StaticResource HintText}"
                           Margin="0"
                           VerticalAlignment="Center"/>
                <CheckBox x:Name="SelectAll"
                          Content="Select all"
                          HorizontalAlignment="Left"
                          Click="SelectAll_Click"/>
            </DockPanel>

            <!-- Rules -->
            <ScrollViewer Grid.Row="1"
                          Margin="25,0,25,16"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <ItemsControl x:Name="RulesList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Click="Rule_Click"
                                      Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Name, and a badge if the rule is disabled -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Rule.Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="150"/>
                                        <ContentControl Style="{StaticResource DisabledBadge}"
                                                        Visibility="{Binding Rule.IsEnabled, Converter={StaticResource TrueToCollapsed}}"
                                                        Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SourcesPreview}"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Foreground="{StaticResource Rule.Source.Foreground}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ServicesPreview}"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Foreground="{StaticResource Rule.Service.Foreground}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Button section -->
            <Border Grid.Row="2" Background="{StaticResource ButtonBar.Background}" BorderBrush="{StaticResource ButtonBar.Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="0,14,25,14" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CopyButton"
                                Content="_Copy"
                                Click="Copy_Click"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"/>
                        <Button x:Name="SaveButton"
                                Content="_Save to file..."
                                Click="Save_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Cancel"
                                Click="Cancel_Click"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Dialog overlay -->
        <UserControl x:Name="DialogOverlay"
                     Visibility="Collapsed"/>
    </Grid>
</local:EditorWindow>
