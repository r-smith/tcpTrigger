<Window x:Class="tcpTrigger.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:tcpTrigger.GUI.Views"
        Title="tcpTrigger"
        Height="338"
        Width="800"
        MinHeight="220"
        MinWidth="470"
        StateChanged="Window_StateChanged"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        Closed="Window_Closed"
        Background="#101010"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource WindowMainPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Window title bar -->
            <Grid Grid.Row="0" Background="#101010">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <!-- Dim title bar elements when window loses focus -->
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Icon -->
                <Image Grid.Column="0"
                       Width="20"
                       Height="20"
                       Margin="8,0,4,0"
                       Source="{StaticResource icon.tcpTrigger}"/>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource TitleBar.Static.Foreground}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

                <!-- Settings button -->
                <Button Style="{StaticResource SettingsButton}"
                        Content="Settings"
                        Grid.Column="4"
                        Margin="0,0,24,0"
                        Click="Settings_Click"/>

                <!-- Preferences menu: settings for this app, per user -->
                <Menu Grid.Column="3"
                      Background="Transparent"
                      BorderThickness="0"
                      FontSize="14"
                      Height="40">
                    <MenuItem Header="Preferences">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.preferences}"/>
                        </MenuItem.Icon>
                        <MenuItem Header="Detailed view"
                                  x:Name="DetailedViewOption"
                                  IsCheckable="True"
                                  InputGestureText="F9"
                                  Click="DetailedViewOption_Click"/>
                        <Separator/>
                        <MenuItem Header="Show window on new detections"
                                  x:Name="FocusOnUpdateOption"
                                  IsCheckable="True"
                                  Click="FocusOnUpdateOption_Click"/>
                        <MenuItem Header="Minimize to tray"
                                  x:Name="MinimizeToTrayOption"
                                  IsCheckable="True"
                                  Click="MinimizeToTrayOption_Click"/>
                        <MenuItem Header="Exit to tray"
                                  x:Name="ExitToTrayOption"
                                  IsCheckable="True"
                                  Click="ExitToTrayOption_Click"/>
                        <MenuItem Header="Start tcpTrigger at sign-in"
                                  x:Name="LaunchAtLogonOption"
                                  IsCheckable="True"
                                  Click="LaunchAtLogonOption_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Minimize button -->
                <Button Grid.Column="5"
                        Click="Minimize_Click"
                        RenderOptions.EdgeMode="Aliased"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="Minimize">
                    <Path Width="46"
                          Height="29"
                          Data="M 18,15 H 28"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1"/>
                </Button>

                <!-- Maximize button -->
                <Grid Grid.Column="6">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <!-- The maximize button collapses when the window is maximized -->
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Button Click="MaximizeRestore_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Maximize">
                        <Path Width="46"
                              Height="31"
                              Data="M 18.5,10.5 H 27.5 V 19.5 H 18.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"/>
                    </Button>
                </Grid>

                <!-- Restore button -->
                <Grid Grid.Column="6">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <!-- The restore button is visible only when the window is maximized -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Button Click="MaximizeRestore_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Restore">
                        <Path Width="46"
                              Height="31"
                              Data="M 18.5,12.5 H 25.5 V 19.5 H 18.5 Z M 20.5,12.5 V 10.5 H 27.5 V 17.5 H 25.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"/>
                    </Button>
                </Grid>

                <!-- Close button -->
                <Button Grid.Column="7"
                        Click="Close_Click"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        ToolTip="Close">
                    <Path Width="46"
                          Height="31"
                          Data="M 18,11 27,20 M 18,20 27,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1"/>
                </Button>
            </Grid>

            <!-- Window content -->
            <Grid Grid.Row="1" Margin="25,10,25,0">
                <Border Background="#000000" BorderBrush="#454D66" BorderThickness="1"
                        CornerRadius="3" Padding="10,10">
                    <ContentControl x:Name="MonitorContent" Focusable="False"/>
                </Border>

                <!-- Heading and filter button on the border line. The panel's background color is
                     split to match the window background above the line and the border box below. -->
                <StackPanel Orientation="Horizontal"
                            Height="18"
                            Margin="10,-9,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                    <StackPanel.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#101010" Offset="0.5"/>
                            <GradientStop Color="#000000" Offset="0.5"/>
                        </LinearGradientBrush>
                    </StackPanel.Background>
                    <TextBlock Text="Connections to this computer"
                               FontSize="13"
                               Foreground="#7A8099"
                               Padding="6,0"
                               VerticalAlignment="Center"/>

                    <!-- Magnifier button that opens the filter -->
                    <Button Height="18"
                            Click="Filter_Click"
                            ToolTip="Filter (Ctrl+F)"
                            AutomationProperties.Name="Filter"
                            Cursor="Hand"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Padding="6,0" Background="Transparent">
                                    <Path x:Name="Icon"
                                          Stroke="#7A8099"
                                          StrokeThickness="1.6"
                                          VerticalAlignment="Center">
                                        <Path.Data>
                                            <GeometryGroup>
                                                <EllipseGeometry Center="5.5,5.5" RadiusX="4.5" RadiusY="4.5"/>
                                                <LineGeometry StartPoint="9,9" EndPoint="13,13"/>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Icon" Property="Stroke" Value="#C8C8C8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Monitoring status, under the detection list -->
            <local:MonitorStatusBar x:Name="ServiceStatusBar"
                                    Grid.Row="2"
                                    SettingsClick="Settings_Click"
                                    ServiceDetailsClick="ServiceDetails_Click"
                                    MonitoringStopped="ServiceStatusBar_MonitoringStopped"/>

            <!-- Dialog overlay -->
            <UserControl x:Name="DialogOverlay"
                         Grid.RowSpan="3"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="Cycle"
                         Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>