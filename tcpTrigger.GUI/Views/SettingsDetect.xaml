<UserControl x:Class="tcpTrigger.GUI.Views.SettingsDetect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             FontSize="14">
    <ScrollViewer Style="{StaticResource TabScrollViewer}">
        <Grid Margin="25,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel>
                <TextBlock Text="Detection"
                           Style="{StaticResource PageHeading}"/>
                <Separator Background="#9184EE"/>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="0,25,0,0">
                <!-- Shown when a file's legacy port lists is converted to ignore rules -->
                <ContentControl x:Name="PortListsConverted"
                                Style="{StaticResource InfoBox}"
                                Content="Port settings from an earlier version were converted to ignore rules. You'll find them on the Ignore page."
                                Margin="0,0,0,25"
                                Visibility="Collapsed"/>

                <!-- ICMP -->
                <CheckBox Content="Detect incoming ICMP requests (ping)"
                          x:Name="DetectIcmp"
                          Click="Input_Changed"/>
                <TextBlock Text="A ping from another computer, often the first step of a network scan."
                           Style="{StaticResource HintText}"
                           Margin="27,5,0,0"/>

                <!-- TCP -->
                <CheckBox Content="Detect incoming TCP connections"
                          x:Name="DetectTcp"
                          Click="Input_Changed"
                          Margin="0,32,0,0"/>
                <TextBlock Text="A connection attempt from another computer, on any TCP port."
                           Style="{StaticResource HintText}"
                           Margin="27,5,0,0"/>

                <!-- UDP -->
                <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                    <CheckBox Content="Detect incoming UDP traffic"
                              x:Name="DetectUdp"
                              Click="DetectUdp_Click"/>
                    <ContentControl Style="{StaticResource AdvancedBadge}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="UDP traffic from another computer. Replies to this computer's own traffic can look like detections. A rule for common UDP traffic is added for you, but more tuning may be needed."
                           Style="{StaticResource HintText}"
                           Margin="27,5,0,0"/>

                <!-- Shown after turning UDP on adds the common UDP traffic rule. The text is set in code. -->
                <ContentControl x:Name="UdpRuleAdded"
                                Style="{StaticResource InfoBox}"
                                Margin="27,10,0,0"
                                Visibility="Collapsed"/>

                <!-- Warning when every detection type is off -->
                <TextBlock Text="All detection types are off, so tcpTrigger won't detect anything."
                           Foreground="#FFD43B"
                           TextWrapping="Wrap"
                           Margin="0,25,0,0">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=DetectIcmp}" Value="False"/>
                                        <Condition Binding="{Binding IsChecked, ElementName=DetectTcp}" Value="False"/>
                                        <Condition Binding="{Binding IsChecked, ElementName=DetectUdp}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>