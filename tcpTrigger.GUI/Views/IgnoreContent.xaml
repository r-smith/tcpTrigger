<UserControl x:Class="tcpTrigger.GUI.Views.IgnoreContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:tcpTrigger.GUI.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=models:IgnoreRule}"
             d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{StaticResource Text.Primary}"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <!-- A multi-line box for one of the rule's lists, entered one entry per line -->
        <Style x:Key="ListInput" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0,5,3,0"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Style.Resources>
                <Style TargetType="{x:Type ScrollViewer}">
                    <Setter Property="Margin" Value="6,4,4,4"/>
                </Style>
            </Style.Resources>
            <!-- Disabled while its dropdown is set to "any". The text is ignored on save, so hide it. -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Transparent"/>
                    <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A "match on" dropdown above a list box: From or Port -->
        <Style x:Key="MatchChoice" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="10,8.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25,0,25,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name and enabled state, on one row -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name"/>
            <TextBox x:Name="FriendlyName"
                     Grid.Column="1"
                     MaxLength="255"
                     Text="{Binding Name, UpdateSourceTrigger=Explicit}"/>
            <CheckBox x:Name="EnabledState"
                      Grid.Column="2"
                      IsChecked="{Binding IsEnabled, UpdateSourceTrigger=Explicit}"
                      Content="Enabled"
                      VerticalAlignment="Center"
                      Margin="18,0,0,0"/>
        </Grid>

        <!-- What the rule matches: ignore traffic from... on port... -->
        <TextBlock Grid.Row="1"
                   Text="Ignore traffic"
                   Style="{StaticResource SectionHeading}"
                   Margin="0,32,0,0"/>

        <!-- From and Port, side by side. The negative margin cancels the last column's gap. -->
        <UniformGrid Grid.Row="2"
                     Rows="1"
                     Columns="2"
                     Margin="0,12,-20,0">
            <!-- Sources -->
            <Grid Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="From" Padding="0"/>
                    <Control x:Name="SourceFormatHelp" Style="{StaticResource HelpIcon}" Margin="5,0,0,0"/>
                </StackPanel>
                <ComboBox Grid.Row="1"
                          AutomationProperties.Name="From"
                          Style="{StaticResource MatchChoice}"
                          SelectionChanged="SourceMatch_SelectionChanged">
                    <ComboBoxItem x:Name="MatchAnySource" Content="any IP address"/>
                    <ComboBoxItem x:Name="MatchSpecificSources" Content="specific IP addresses" IsSelected="True"/>
                </ComboBox>
                <TextBox x:Name="SourceList"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         IsEnabled="{Binding IsSelected, ElementName=MatchSpecificSources}"
                         AutomationProperties.Name="Source IP addresses"
                         Tag="One IP address, range, or CIDR per line"
                         Style="{StaticResource ListInput}"/>
            </Grid>

            <!-- Ports and protocols -->
            <Grid Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Port" Padding="0"/>
                    <Control x:Name="ServiceFormatHelp" Style="{StaticResource HelpIcon}" Margin="5,0,0,0"/>
                </StackPanel>
                <ComboBox Grid.Row="1"
                          AutomationProperties.Name="Port"
                          Style="{StaticResource MatchChoice}"
                          SelectionChanged="ServiceMatch_SelectionChanged">
                    <ComboBoxItem x:Name="MatchAnyService" Content="any port"/>
                    <ComboBoxItem x:Name="MatchSpecificServices" Content="specific ports" IsSelected="True"/>
                </ComboBox>
                <TextBox x:Name="ServiceList"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         IsEnabled="{Binding IsSelected, ElementName=MatchSpecificServices}"
                         AutomationProperties.Name="Ports and protocols"
                         Tag="One port or protocol per line"
                         Style="{StaticResource ListInput}"/>
            </Grid>
        </UniformGrid>

        <!-- Destination addresses, behind a link -->
        <StackPanel Grid.Row="3" Margin="0,14,0,22">
            <ToggleButton x:Name="LimitDestinations"
                          Content="Limit to specific destination IP addresses"
                          Style="{StaticResource LinkToggleButton}"
                          HorizontalAlignment="Left"
                          Margin="-4,0,0,0"
                          Checked="LimitDestinations_Checked"/>
            <StackPanel Visibility="{Binding IsChecked, ElementName=LimitDestinations, Converter={StaticResource TrueToVisible}}">
                <TextBlock Text="Only needed when this computer has more than one IP address."
                           Style="{StaticResource HintText}"
                           Margin="0,6,0,6"/>
                <TextBox x:Name="DestinationList"
                         Height="60"
                         AutomationProperties.Name="Destination IP addresses"
                         Style="{StaticResource ListInput}"/>
                <!-- This computer's addresses. Clicking one adds it to the box. Filled in by code. -->
                <WrapPanel x:Name="LocalAddressButtons" Margin="0,8,0,0">
                    <TextBlock Text="This computer:" Style="{StaticResource HintText}" Margin="0,0,8,4"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
