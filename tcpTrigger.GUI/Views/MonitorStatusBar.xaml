<UserControl x:Class="tcpTrigger.GUI.Views.MonitorStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:tcpTrigger.GUI.Views.Controls"
             mc:Ignorable="d"
             d:DesignWidth="800">
    <!-- Shows one of two things under the detection list, depending on the service. -->
    <Grid>
        <!-- Monitoring (the service is running) -->
        <Grid x:Name="MonitoringBar"
              Height="36"
              Margin="25,0"
              Visibility="Collapsed">
            <Button x:Name="ServiceStatusButton"
                    Click="ServiceStatus_Click"
                    AutomationProperties.Name="Service options"
                    FocusVisualStyle="{StaticResource SmallButtonFocusVisual}"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="-6,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="HoverBackground"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="6,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBackground" Property="Background" Value="#202020"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <ContextMenu Placement="Top">
                        <MenuItem Header="Stop service..." Click="StopService_Click">
                            <!-- Shield icon -->
                            <MenuItem.Icon>
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,3 L19,6 L19,11 C19,15.5 16,19 12,21 C8,19 5,15.5 5,11 L5,6 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Service details" Click="ServiceDetails_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="#00FA9A"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="MonitoringText"
                               Text="Monitoring"
                               FontSize="13"
                               Foreground="#C8C8C8"
                               Margin="0,0,0,2"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Not monitoring (the service is not running) -->
        <Border x:Name="NotMonitoringBanner"
                Margin="25,10,25,16"
                Padding="12,8"
                Background="#1E1A0B"
                BorderBrush="#6B5A1A"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="Collapsed">
            <DockPanel>
                <!-- Warning icon -->
                <Viewbox DockPanel.Dock="Left"
                         Width="18"
                         Height="18"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,3 L22,21 L2,21 Z M12,10 L12,15 M12,18 L12,18.5"
                              Stroke="#FFD43B"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>

                <!-- Start service button -->
                <Button x:Name="StartButton"
                        DockPanel.Dock="Right"
                        Click="Start_Click"
                        Padding="12,4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Spinner animation: shown while starting -->
                        <controls:Spinner x:Name="StartingSpinner"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                        <!-- Shield icon -->
                        <Viewbox x:Name="ShieldIcon"
                                 Width="14"
                                 Height="14"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 L19,6 L19,11 C19,15.5 16,19 12,21 C8,19 5,15.5 5,11 L5,6 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="StartButtonText" Text="Start service"/>
                    </StackPanel>
                </Button>

                <!-- Open settings button. Shown instead of start service when there's no settings file yet. -->
                <Button x:Name="SettingsButton"
                        DockPanel.Dock="Right"
                        Content="Open Settings"
                        Click="Settings_Click"
                        Padding="12,4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>

                <TextBlock x:Name="BannerText"
                           d:Text="Not monitoring. The tcpTrigger service is stopped."
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#F1F1F1"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>