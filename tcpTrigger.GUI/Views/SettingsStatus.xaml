<UserControl x:Class="tcpTrigger.GUI.Views.SettingsStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:tcpTrigger.GUI.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer Style="{StaticResource TabScrollViewer}">
        <Grid Margin="25,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel>
                <TextBlock Text="Service status"
                           Style="{StaticResource PageHeading}"/>
                <Separator Background="#9184EE"/>
            </StackPanel>

            <!-- Content -->
            <DockPanel Grid.Row="1" Margin="0,25,0,0">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="StatusImage"
                           Source="{StaticResource icon.check-circle}"
                           Grid.RowSpan="2"
                           Width="54"
                           Height="54"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="The tcpTrigger service is currently "
                                   Foreground="#FFFFFF"
                                   FontSize="14"/>
                        <TextBlock x:Name="ServiceStatus"
                                   d:Text="running"
                                   Foreground="#FFFFFF"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="ServiceControl"
                                Click="ServiceControl_Click"
                                Width="160">
                            <StackPanel Orientation="Horizontal">
                                <controls:Spinner x:Name="Spinner"
                                                  Visibility="Collapsed"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Width="19"
                                                  Height="19"
                                                  Margin="0,0,8,0"/>
                                <TextBlock x:Name="ServiceControlButtonText"
                                           Text="Start service"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Open Windows Services"
                                Click="OpenServices_Click"
                                Width="200"
                                Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>