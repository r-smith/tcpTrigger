<UserControl x:Class="tcpTrigger.GUI.Views.NotificationCommand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:tcpTrigger.GUI.Models"
             xmlns:controls="clr-namespace:tcpTrigger.GUI.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=models:NotificationCommand}"
             d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{StaticResource Text.Primary}"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,9,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource TabScrollViewer}">
        <StackPanel x:Name="MainPanel" Margin="25,0,25,5">
            <!-- Name and enabled state, on one row -->
            <Grid Margin="0,23,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name"/>
                <TextBox x:Name="FriendlyName"
                         Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                         Grid.Column="1"/>
                <CheckBox x:Name="EnabledState"
                          Grid.Column="2"
                          IsChecked="{Binding IsEnabled, UpdateSourceTrigger=Explicit}"
                          Content="Enabled"
                          VerticalAlignment="Center"
                          Margin="18,0,0,0"/>
            </Grid>

            <!-- Command settings -->
            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,24,0,0">
                <!-- Path -->
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Labels" Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Program path"
                               VerticalAlignment="Top"
                               Margin="0,9,0,0"/>
                    <TextBox x:Name="Path"
                             Text="{Binding Path, UpdateSourceTrigger=Explicit}"
                             Grid.Column="1"
                             Padding="0,4.5,2,4.5"
                             MaxHeight="66"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Margin" Value="6,4,4,4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource SecondaryButton}"
                            Click="Browse_Click"
                            HorizontalAlignment="Left"
                            MinWidth="0"
                            Margin="0,6,0,0"
                            Padding="15,4"/>
                </Grid>

                <!-- Arguments -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Labels" Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Arguments"
                               VerticalAlignment="Top"
                               Margin="0,12,0,0"/>
                    <TextBox x:Name="Arguments"
                             Tag="(optional)"
                             Text="{Binding Arguments, UpdateSourceTrigger=Explicit}"
                             Grid.Column="1"
                             Padding="0,8,2,8"
                             MinHeight="96"
                             MaxHeight="140"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Margin" Value="6,4,4,4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <!-- Variables that can go in the arguments -->
                    <controls:VariablePicker x:Name="VariableList"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="0,8,0,0"
                                             Hint="Click a variable to insert it. Each one is replaced with details of the detection."/>
                </Grid>

                <!-- How the service runs this notification -->
                <ContentControl Style="{StaticResource InfoBox}"
                                Margin="0,20,0,0"
                                Content="The tcpTrigger service starts this program in the background, under its own account. A script or command-line tool works best."/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
