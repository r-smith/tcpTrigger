<UserControl x:Class="tcpTrigger.GUI.Views.IgnoreRuleChecklist"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Select all, and how many are selected -->
        <DockPanel Margin="0,0,0,4">
            <TextBlock x:Name="SelectedCountText"
                       DockPanel.Dock="Right"
                       Style="{StaticResource HintText}"
                       Margin="0,0,13,0"
                       VerticalAlignment="Center"/>
            <CheckBox x:Name="SelectAll"
                      Style="{StaticResource ListCheckBox}"
                      Content="Select all"
                      HorizontalAlignment="Left"
                      Margin="5,0,0,0"
                      Click="SelectAll_Click"/>
        </DockPanel>

        <!-- Rules -->
        <Border Grid.Row="1"
                Background="{StaticResource Checklist.Background}"
                BorderBrush="{StaticResource Checklist.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <ItemsControl x:Name="RulesList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource ListCheckBox}"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding CanSelect}"
                                      Click="Rule_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Name -->
                                    <TextBlock Text="{Binding Rule.Name}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- Badges, such as "Disabled" or "Already exists" -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource DisabledBadge}"
                                                        Visibility="{Binding Rule.IsEnabled, Converter={StaticResource TrueToCollapsed}}"
                                                        Margin="10,0,0,0"/>
                                        <ContentControl Style="{StaticResource WarningBadge}"
                                                        Content="{Binding WarningBadge}"
                                                        Margin="10,0,0,0"/>
                                        <ContentControl Style="{StaticResource ErrorBadge}"
                                                        Content="{Binding ErrorBadge}"
                                                        Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
