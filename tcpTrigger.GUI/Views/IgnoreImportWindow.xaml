<local:EditorWindow x:Class="tcpTrigger.GUI.Views.IgnoreImportWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:tcpTrigger.GUI.Views"
                    Title="Import ignore rules"
                    Height="480"
                    Width="500"
                    MinHeight="320"
                    MinWidth="380"
                    MouseDown="Window_MouseDown"
                    ShowInTaskbar="False"
                    Background="{StaticResource Window.Background}"
                    WindowStartupLocation="CenterOwner"
                    FontSize="14">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Window content -->
        <Grid IsEnabled="{Binding Visibility, ElementName=DialogOverlay, Converter={StaticResource VisibleToDisabled}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- What was found, and where -->
            <TextBlock x:Name="Summary"
                       Foreground="{StaticResource ImportSummary.Foreground}"
                       TextWrapping="Wrap"
                       Margin="25,20,25,14"/>

            <!-- Rules -->
            <local:IgnoreRuleChecklist x:Name="Checklist"
                                       Grid.Row="1"
                                       Margin="25,0,25,16"
                                       SelectionChanged="Checklist_SelectionChanged"/>

            <!-- Button section -->
            <Border Grid.Row="2" Background="{StaticResource ButtonBar.Background}" BorderBrush="{StaticResource ButtonBar.Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="0,14,25,14" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddButton"
                                Click="Add_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Cancel"
                                Click="Cancel_Click"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Dialog overlay -->
        <UserControl x:Name="DialogOverlay"
                     Visibility="Collapsed"/>
    </Grid>
</local:EditorWindow>
