<UserControl x:Class="tcpTrigger.GUI.Views.NotificationLogFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:tcpTrigger.GUI.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=models:NotificationLogFile}"
             d:DesignHeight="450" d:DesignWidth="800"
             Foreground="#FFFFFF"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,9,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource TabScrollViewer}">
        <StackPanel x:Name="MainPanel" Margin="60,0,60,5">
            <!-- Name and enabled state, on one row -->
            <Grid Margin="0,23,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name"/>
                <TextBox x:Name="FriendlyName"
                         Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                         Grid.Column="1"/>
                <CheckBox x:Name="EnabledState"
                          Grid.Column="2"
                          IsChecked="{Binding IsEnabled, UpdateSourceTrigger=Explicit}"
                          Content="Enabled"
                          VerticalAlignment="Center"
                          Margin="18,0,0,0"/>
            </Grid>

            <!-- Log settings -->
            <TextBlock Text="Log"
                       Style="{StaticResource SectionHeading}"
                       Margin="0,40,0,1"/>
            <Separator Background="#9184EE"/>
            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,12,0,0">
                <!-- How the service runs this notification -->
                <ContentControl Style="{StaticResource InfoBox}"
                                Margin="0,0,0,14"
                                Content="The tcpTrigger service writes this file under its own account. Choose a folder it can write to, such as C:\ProgramData\tcpTrigger. Folders in your user profile, like Desktop or Documents, won't work."/>

                <!-- Path -->
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Labels" Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Path to log file"
                               VerticalAlignment="Top"
                               Margin="0,9,0,0"/>
                    <TextBox x:Name="Path"
                             Text="{Binding Path, UpdateSourceTrigger=Explicit}"
                             Grid.Column="1"
                             Padding="0,4.5,2,4.5"
                             MaxHeight="66"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Margin" Value="6,4,4,4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource BrowseButton}"
                            Click="Browse_Click"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Padding="15,4"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>