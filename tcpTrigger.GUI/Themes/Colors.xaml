<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors used by the app's styles and views -->

    <!-- Window border -->
    <SolidColorBrush x:Key="Window.Static.Border" Color="#454D66"/>

    <!-- Title bar text and caption buttons -->
    <SolidColorBrush x:Key="TitleBar.Static.Foreground" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="TitleBarButton.MouseOver.Background" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarButton.Pressed.Background" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="TitleBarCloseButton.MouseOver.Background" Color="#C42B1C"/>
    <SolidColorBrush x:Key="TitleBarCloseButton.MouseOver.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarCloseButton.Pressed.Background" Color="#B42A1C"/>

    <!-- Accent: primary buttons, the add button, and checked checkboxes -->
    <SolidColorBrush x:Key="Accent.Static.Background" Color="#9184EE"/>
    <SolidColorBrush x:Key="Accent.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="Accent.MouseOver.Background" Color="#A59AF1"/>
    <SolidColorBrush x:Key="Accent.Pressed.Background" Color="#7969EA"/>

    <!-- Focus outlines. Inputs (text boxes and combo boxes) use their own color. -->
    <SolidColorBrush x:Key="FocusVisual.Border" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="InputFocus.Border" Color="#48E3FF"/>

    <!-- Secondary button -->
    <SolidColorBrush x:Key="Button.Secondary.Static.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Button.Secondary.Static.Background" Color="#353535"/>
    <SolidColorBrush x:Key="Button.Secondary.Static.Foreground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Button.Secondary.MouseOver.Border" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Button.Secondary.MouseOver.Background" Color="#454545"/>
    <SolidColorBrush x:Key="Button.Secondary.Pressed.Background" Color="#2A2A2A"/>

    <!-- Danger button -->
    <SolidColorBrush x:Key="Button.Danger.Static.Background" Color="#EA4A5A"/>
    <SolidColorBrush x:Key="Button.Danger.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="Button.Danger.MouseOver.Background" Color="#F06B78"/>
    <SolidColorBrush x:Key="Button.Danger.Pressed.Background" Color="#C93A49"/>

    <!-- Browse button. The delete button uses its hover and pressed backgrounds. -->
    <SolidColorBrush x:Key="Button.Browse.Static.Background" Color="#000000"/>
    <SolidColorBrush x:Key="Button.Browse.Static.Border" Color="#246BFD"/>
    <SolidColorBrush x:Key="Button.Browse.Static.Foreground" Color="#0BFFDB"/>
    <SolidColorBrush x:Key="Button.Browse.MouseOver.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Button.Browse.Pressed.Background" Color="#000000"/>

    <!-- Delete button text -->
    <SolidColorBrush x:Key="Button.Delete.Foreground" Color="#EEEEFF"/>

    <!-- CheckBox -->
    <SolidColorBrush x:Key="CheckBox.Unchecked.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckBox.Unchecked.Background" Color="#000000"/>
    <SolidColorBrush x:Key="CheckBox.Unchecked.Border" Color="#605F76"/>
    <SolidColorBrush x:Key="CheckBox.Checked.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckBox.MouseOver.Foreground" Color="#FFFFAA"/>
    <SolidColorBrush x:Key="CheckBox.MouseOver.Background" Color="#121212"/>
    <SolidColorBrush x:Key="CheckBox.MouseOver.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckBox.Pressed.Background" Color="#AA9184EE"/>
    <SolidColorBrush x:Key="CheckBox.Pressed.Border" Color="#AA9184EE"/>

    <!-- ComboBox -->
    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="#141414"/>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#72809D"/>
    <SolidColorBrush x:Key="ComboBox.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="#282828"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="#141414"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.DropDown.Background" Color="#040404"/>
    <SolidColorBrush x:Key="ComboBox.DropDown.Border" Color="#5F8CFF"/>
    <Color x:Key="ComboBox.DropDown.Shadow">#A1000000</Color>
    <SolidColorBrush x:Key="ComboBoxItem.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemsviewHover.Background" Color="#282828"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemsviewHover.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemsviewSelected.Glyph" Color="#88B0FF"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="{x:Static DataGrid.FocusBorderBrushKey}" Color="#000000"/>
    <SolidColorBrush x:Key="DG.Static.Background" Color="#000000"/>
    <SolidColorBrush x:Key="DG.Header.Static.Background" Color="#000000"/>
    <SolidColorBrush x:Key="DG.Header.Static.Foreground" Color="#7FD6A6"/>
    <SolidColorBrush x:Key="DG.Header.Static.Border" Color="#000000"/>
    <SolidColorBrush x:Key="DG.Row.Static.Background" Color="#000000"/>
    <SolidColorBrush x:Key="DG.Row.Static.Foreground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="DG.Row.Selected.Background" Color="#101820"/>
    <SolidColorBrush x:Key="DG.Row.MouseOver.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DG.Row.MouseOver.Border" Color="#50303030"/>
    <SolidColorBrush x:Key="DG.Gridlines.Border" Color="#303030"/>

    <!-- Menus and context menus -->
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#454D66"/>
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Menu.Static.Separator" Color="Transparent"/>
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#707070"/>
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#292929"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="#0A000000"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="#21000000"/>

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBar.Track.Background" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.Static.Background" Color="#666666"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.Static.Border" Color="#808080"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.MouseOver.Background" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.Pressed.Background" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ScrollBar.Arrow.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBar.Arrow.Static.Glyph" Color="#999999"/>
    <SolidColorBrush x:Key="ScrollBar.Arrow.MouseOver.Background" Color="#999999"/>
    <SolidColorBrush x:Key="ScrollBar.Arrow.MouseOver.Glyph" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ScrollBar.Arrow.Pressed.Background" Color="#909090"/>
    <SolidColorBrush x:Key="ScrollBar.Arrow.Pressed.Glyph" Color="#101010"/>

    <!-- Settings tabs (vertical TabControl) -->
    <SolidColorBrush x:Key="TabItemVert.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItemVert.Static.Border" Color="#454D66"/>
    <SolidColorBrush x:Key="TabItemVert.Static.Foreground" Color="#959DA5"/>
    <SolidColorBrush x:Key="TabItemVert.MouseOver.Background" Color="#24292E"/>
    <SolidColorBrush x:Key="TabItemVert.Selected.Background" Color="#000000"/>
    <SolidColorBrush x:Key="TabItemVert.Selected.Border" Color="#214462"/>
    <SolidColorBrush x:Key="TabItemVert.Selected.Foreground" Color="#EA4A5A"/>
    <SolidColorBrush x:Key="TabItemVert.SelectedMouseOver.Background" Color="#141414"/>
    <SolidColorBrush x:Key="TabControlVert.Content.Background" Color="#000000"/>
    <SolidColorBrush x:Key="TabControlVert.Content.Border" Color="#000000"/>

    <!-- TextBox and PasswordBox -->
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#020305"/>
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#2F363D"/>
    <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#FFD43B"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Background" Color="#020305"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBox.Focus.Background" Color="#000000"/>
    <SolidColorBrush x:Key="TextBox.Selection.Active" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBox.Selection.Inactive" Color="#A9A9A9"/>

    <!-- Text styles: hint under an input, settings page heading, editor section heading -->
    <SolidColorBrush x:Key="HintText.Foreground" Color="#909090"/>
    <SolidColorBrush x:Key="PageHeading.Foreground" Color="#00FA9A"/>
    <SolidColorBrush x:Key="SectionHeading.Foreground" Color="#61B8FF"/>

    <!-- InfoBox -->
    <SolidColorBrush x:Key="InfoBox.Background" Color="#0D1724"/>
    <SolidColorBrush x:Key="InfoBox.Border" Color="#2A4A6B"/>
    <SolidColorBrush x:Key="InfoBox.Icon" Color="#61B8FF"/>
    <SolidColorBrush x:Key="InfoBox.Foreground" Color="#E0E0E0"/>

    <!-- Badges -->
    <SolidColorBrush x:Key="DisabledBadge.Background" Color="#1AFFD43B"/>
    <SolidColorBrush x:Key="DisabledBadge.Border" Color="#8CFFD43B"/>
    <SolidColorBrush x:Key="DisabledBadge.Foreground" Color="#FFD43B"/>
    <SolidColorBrush x:Key="AdvancedBadge.Background" Color="#268E6EFF"/>
    <SolidColorBrush x:Key="AdvancedBadge.Border" Color="#8C8E6EFF"/>
    <SolidColorBrush x:Key="AdvancedBadge.Foreground" Color="#B7A6FF"/>

    <!-- ==== Monitor window ==== -->

    <!-- Window background, and the detection list box. The Color versions are for the gradient
         behind the list heading, which must match both backgrounds. -->
    <Color x:Key="Monitor.Window.BackgroundColor">#101010</Color>
    <Color x:Key="Monitor.List.BackgroundColor">#000000</Color>
    <SolidColorBrush x:Key="Monitor.Window.Background" Color="{StaticResource Monitor.Window.BackgroundColor}"/>
    <SolidColorBrush x:Key="Monitor.List.Background" Color="{StaticResource Monitor.List.BackgroundColor}"/>
    <SolidColorBrush x:Key="Monitor.List.Border" Color="#454D66"/>

    <!-- List heading on the border line, and its filter button -->
    <SolidColorBrush x:Key="Monitor.ListHeading.Foreground" Color="#7A8099"/>
    <SolidColorBrush x:Key="Monitor.ListHeading.MouseOver.Foreground" Color="#C8C8C8"/>

    <!-- Filter bar -->
    <SolidColorBrush x:Key="Monitor.FilterBar.Border" Color="#262B3A"/>
    <SolidColorBrush x:Key="Monitor.FilterBar.Foreground" Color="#959AAE"/>
    <SolidColorBrush x:Key="Monitor.FilterBar.Placeholder" Color="#707070"/>
    <SolidColorBrush x:Key="Monitor.FilterBar.CloseGlyph" Color="#A0A0A0"/>

    <!-- Small icon buttons: close filter, service status -->
    <SolidColorBrush x:Key="Monitor.SmallButton.MouseOver.Background" Color="#202020"/>

    <!-- Detection rows, in both the compact and detailed views -->
    <SolidColorBrush x:Key="Monitor.Date.Foreground" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Monitor.Time.Foreground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Monitor.SourceIP.Foreground" Color="#FFD43B"/>
    <SolidColorBrush x:Key="Monitor.DestinationIP.Foreground" Color="#999999"/>
    <SolidColorBrush x:Key="Monitor.Description.Foreground" Color="#707070"/>
    <SolidColorBrush x:Key="Monitor.Port.Foreground" Color="#61B8FF"/>
    <SolidColorBrush x:Key="Monitor.PortName.Foreground" Color="#B84DB8"/>
    <SolidColorBrush x:Key="Monitor.Protocol.Foreground" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Monitor.Endpoints.Foreground" Color="#2EDCDC"/>

    <!-- Empty list and loading overlays -->
    <SolidColorBrush x:Key="Monitor.EmptyTitle.Foreground" Color="#FFD43B"/>
    <SolidColorBrush x:Key="Monitor.EmptyMessage.Foreground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Monitor.Loading.Spinner" Color="#61B8FF"/>
    <SolidColorBrush x:Key="Monitor.Loading.Foreground" Color="#CCCCCC"/>

    <!-- Status bar: monitoring, and the banner shown when the service is stopped -->
    <SolidColorBrush x:Key="Monitor.Status.Running" Color="#00FA9A"/>
    <SolidColorBrush x:Key="Monitor.Status.Foreground" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Monitor.StoppedBanner.Background" Color="#1E1A0B"/>
    <SolidColorBrush x:Key="Monitor.StoppedBanner.Border" Color="#6B5A1A"/>
    <SolidColorBrush x:Key="Monitor.StoppedBanner.Icon" Color="#FFD43B"/>
    <SolidColorBrush x:Key="Monitor.StoppedBanner.Foreground" Color="#F1F1F1"/>

    <!-- ==== Settings window and editors ==== -->

    <!-- Window background, and the border of the rule and notification editors -->
    <SolidColorBrush x:Key="Window.Background" Color="#000000"/>
    <SolidColorBrush x:Key="EditorWindow.Border" Color="#707070"/>

    <!-- Button bar at the bottom of the window -->
    <SolidColorBrush x:Key="ButtonBar.Background" Color="#141517"/>
    <SolidColorBrush x:Key="ButtonBar.Border" Color="#303030"/>

    <!-- Text: labels, the editor title, captions above list inputs, warnings -->
    <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditorTitle.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldCaption.Foreground" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="WarningText.Foreground" Color="#FFD43B"/>

    <!-- Line under page and section headings -->
    <SolidColorBrush x:Key="Heading.Separator" Color="#9184EE"/>

    <!-- "Notification type: Email" in the notification editor -->
    <SolidColorBrush x:Key="NotificationType.Label.Foreground" Color="#666666"/>
    <SolidColorBrush x:Key="NotificationType.Foreground" Color="#AAAAAA"/>

    <!-- Save status next to the Save button. Set in code. -->
    <SolidColorBrush x:Key="SaveStatus.Normal" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="SaveStatus.Warning" Color="#FFD43B"/>

    <!-- Notification and ignore rule lists -->
    <SolidColorBrush x:Key="SettingsList.Item.Static.Background" Color="#000000"/>
    <SolidColorBrush x:Key="SettingsList.Item.MouseOver.Background" Color="#111111"/>
    <SolidColorBrush x:Key="SettingsList.Item.MouseOver.Border" Color="#444455"/>
    <SolidColorBrush x:Key="SettingsList.Item.Focused.Background" Color="#222233"/>
    <SolidColorBrush x:Key="SettingsList.Name.Foreground" Color="#EEEEFF"/>
    <SolidColorBrush x:Key="SettingsList.Chevron.Foreground" Color="#707070"/>
    <SolidColorBrush x:Key="SettingsList.Header.Border" Color="#262A33"/>
    <SolidColorBrush x:Key="SettingsList.Header.Foreground" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="SettingsList.More.Foreground" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="SettingsList.Empty.Foreground" Color="#9A9A9A"/>

    <!-- Ignore rule sources, destination addresses, and ports and protocols -->
    <SolidColorBrush x:Key="Rule.Source.Foreground" Color="#44CCDD"/>
    <SolidColorBrush x:Key="Rule.Destination.Foreground" Color="#B7A6FF"/>
    <SolidColorBrush x:Key="Rule.Service.Foreground" Color="#DD66DD"/>

    <!-- ==== Dialogs ==== -->
    <SolidColorBrush x:Key="Dialog.Overlay" Color="#88000000"/>
    <SolidColorBrush x:Key="Dialog.Background" Color="#181818"/>
    <SolidColorBrush x:Key="Dialog.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Dialog.Border" Color="#9184EE"/>
    <SolidColorBrush x:Key="Dialog.Warning.Border" Color="#FFD43B"/>
    <SolidColorBrush x:Key="Dialog.Danger.Border" Color="#FD005C"/>
    <SolidColorBrush x:Key="Dialog.RuleName.Foreground" Color="#FFFFAA"/>
</ResourceDictionary>
