<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A small rounded label. The styles below set the text and colors. -->
    <Style x:Key="Badge" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="8,1">
                        <ContentPresenter TextElement.FontFamily="Segoe UI"
                                          TextElement.FontSize="12"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Marks a disabled notification or ignore rule in the settings lists.
         Use: <ContentControl Style="{StaticResource DisabledBadge}"/> -->
    <Style x:Key="DisabledBadge" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Badge}">
        <Setter Property="Content" Value="Disabled"/>
        <Setter Property="Background" Value="{StaticResource DisabledBadge.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DisabledBadge.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource DisabledBadge.Foreground}"/>
    </Style>

    <!-- Marks a setting for experienced users, such as UDP detection.
         Use: <ContentControl Style="{StaticResource AdvancedBadge}"/> -->
    <Style x:Key="AdvancedBadge" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Badge}">
        <Setter Property="Content" Value="Advanced"/>
        <Setter Property="Background" Value="{StaticResource AdvancedBadge.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AdvancedBadge.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource AdvancedBadge.Foreground}"/>
    </Style>

    <!-- Warns about a notification in the settings list. Hidden while it has no text.
         Use: <ContentControl Style="{StaticResource WarningBadge}" Content="Text"/> -->
    <Style x:Key="WarningBadge" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource WarningBadge.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarningBadge.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource WarningBadge.Foreground}"/>
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Marks a problem with a notification in the settings list. Hidden while it has no text.
         Use: <ContentControl Style="{StaticResource ErrorBadge}" Content="Text"/> -->
    <Style x:Key="ErrorBadge" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource ErrorBadge.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBadge.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBadge.Foreground}"/>
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
