<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="TabItemVert.Selected.Background" Color="#000000"/>
    <SolidColorBrush x:Key="TabItemVert.Selected.Border" Color="#214462"/>
    <SolidColorBrush x:Key="TabItemVert.Selected.Foreground" Color="#EA4A5A"/>
    <SolidColorBrush x:Key="TabItemVert.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItemVert.Static.Border" Color="#454D66"/>
    <SolidColorBrush x:Key="TabItemVert.Static.Foreground" Color="#959DA5"/>
    <SolidColorBrush x:Key="TabItemVert.MouseOver.Background" Color="#24292E"/>
    <SolidColorBrush x:Key="TabControlVert.Content.Background" Color="#000000"/>
    <SolidColorBrush x:Key="TabControlVert.Content.Border" Color="#000000"/>

    <!-- Vertical focus visual -->
    <Style x:Key="TabVertFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Rectangle Stroke="#E8E8E8"
                                   RadiusX="4"
                                   RadiusY="4"
                                   SnapsToDevicePixels="true"
                                   StrokeThickness="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical tab header -->
    <DataTemplate x:Key="TabVertHeader">
        <TextBlock Text="{Binding}"
                   FontSize="20"
                   FontFamily="Corbel"
                   Foreground="{StaticResource TabItemVert.Static.Foreground}"/>
    </DataTemplate>
    <DataTemplate x:Key="TabVertSelectedHeader">
        <TextBlock Text="{Binding}"
                   FontSize="20"
                   FontFamily="Corbel"
                   Foreground="{StaticResource TabItemVert.Selected.Foreground}"/>
    </DataTemplate>

    <!-- Vertical tab style -->
    <Style x:Key="TabItemVerticalStyle" TargetType="{x:Type TabItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TabVertFocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource TabItemVert.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TabItemVert.Static.Border}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="10,14,40,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HeaderTemplate" Value="{StaticResource TabVertHeader}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                        <Border x:Name="mainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="0,1">
                            <Border x:Name="innerBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0"
                                    Margin="0,3,5,3"
                                    CornerRadius="3"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <Image x:Name="Icon"
                                   Source="{x:Null}"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,12,0"
                                   Opacity="0.3"
                                   Focusable="False"
                                   HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                   VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              Focusable="False"
                                              HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="Detect">
                            <Setter TargetName="Icon" Property="Source" Value="{StaticResource icon.eye}"/>
                        </Trigger>
                        <Trigger Property="Header" Value="Notify">
                            <Setter TargetName="Icon" Property="Source" Value="{StaticResource icon.megaphone}"/>
                        </Trigger>
                        <Trigger Property="Header" Value="Ignore">
                            <Setter TargetName="Icon" Property="Source" Value="{StaticResource icon.closedeye}"/>
                        </Trigger>
                        <Trigger Property="Header" Value="Status">
                            <Setter TargetName="Icon" Property="Source" Value="{StaticResource icon.activity}"/>
                        </Trigger>
                        <Trigger Property="Header" Value="Devices">
                            <Setter TargetName="Icon" Property="Source" Value="{StaticResource icon.router}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Mode=Self}}" Value="true">
                            <Setter Property="Background" TargetName="innerBorder" Value="{StaticResource TabItemVert.MouseOver.Background}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=Self}}" Value="false">
                            <Setter Property="BorderBrush" TargetName="innerBorder" Value="{StaticResource TabItemVert.Static.Background}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=Self}}" Value="true">
                            <Setter Property="Background" TargetName="innerBorder" Value="{StaticResource TabItemVert.Selected.Background}"/>
                            <Setter Property="BorderBrush" TargetName="innerBorder" Value="{StaticResource TabItemVert.Selected.Border}"/>
                            <Setter Property="BorderThickness" TargetName="innerBorder" Value="0,0,0,0"/>
                            <Setter Property="HeaderTemplate" Value="{StaticResource TabVertSelectedHeader}"/>
                            <Setter Property="Opacity" TargetName="Icon" Value="1"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=Self}}" Value="true"/>
                                <Condition Binding="{Binding IsMouseOver, ElementName=templateRoot}" Value="true"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" TargetName="innerBorder" Value="#141414"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical tab control style -->
    <Style x:Key="TabControlVerticalStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid x:Name="templateRoot" ClipToBounds="true" SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0"/>
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                            <RowDefinition x:Name="RowDefinition1" Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Tab items -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Border BorderBrush="{StaticResource TabControlVert.Content.Border}"
                                    BorderThickness="0,1,0,0">
                                <TabPanel x:Name="headerPanel"
                                          Background="Transparent"
                                          Grid.Column="0"
                                          IsItemsHost="true"
                                          Margin="10,0,0,0"
                                          Grid.Row="0"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1"/>
                            </Border>
                        </ScrollViewer>
                        <!-- Tab content -->
                        <Border x:Name="contentPanel"
                                Background="{StaticResource TabControlVert.Content.Background}"
                                BorderBrush="{StaticResource TabControlVert.Content.Border}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Grid.Column="0"
                                Grid.Row="1"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="Grid.Row" TargetName="headerPanel" Value="0"/>
                            <Setter Property="Grid.Row" TargetName="contentPanel" Value="0"/>
                            <Setter Property="Grid.Column" TargetName="headerPanel" Value="0"/>
                            <Setter Property="Grid.Column" TargetName="contentPanel" Value="1"/>
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto"/>
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="*"/>
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>