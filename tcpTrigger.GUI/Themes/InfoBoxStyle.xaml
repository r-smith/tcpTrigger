<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Callout icons, drawn on a 24 by 24 canvas -->
    <GeometryGroup x:Key="InfoIcon">
        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
        <PathGeometry Figures="M12,11 L12,17 M12,7.5 L12,8"/>
    </GeometryGroup>
    <PathGeometry x:Key="WarningIcon" Figures="M12,3 L22,21 L2,21 Z M12,10 L12,15 M12,18 L12,18.5"/>

    <!-- A boxed note with an icon. The styles below set the colors and the icon, which goes in Tag.
         The icon uses Foreground; the text color is the same for every callout. -->
    <Style x:Key="Callout" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,9">
                        <DockPanel>
                            <!-- Icon -->
                            <Viewbox DockPanel.Dock="Left"
                                     Width="18"
                                     Height="18"
                                     Margin="0,1,10,0"
                                     VerticalAlignment="Top">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.8"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       Foreground="{StaticResource Callout.Foreground}"
                                       VerticalAlignment="Top"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A note that explains how something works, shown above the inputs it's about.
         Use: <ContentControl Style="{StaticResource InfoBox}" Content="Text to show"/> -->
    <Style x:Key="InfoBox" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Callout}">
        <Setter Property="Tag" Value="{StaticResource InfoIcon}"/>
        <Setter Property="Background" Value="{StaticResource InfoBox.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoBox.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource InfoBox.Icon}"/>
    </Style>

    <!-- A warning about a setting, such as every detection type being off.
         Use: <ContentControl Style="{StaticResource WarningBox}" Content="Text to show"/> -->
    <Style x:Key="WarningBox" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Callout}">
        <Setter Property="Tag" Value="{StaticResource WarningIcon}"/>
        <Setter Property="Background" Value="{StaticResource WarningBox.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarningBox.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource WarningBox.Icon}"/>
    </Style>

    <!-- A small info icon that shows help in a tooltip. Give it a ToolTip with the HelpToolTip style. -->
    <Style x:Key="HelpIcon" TargetType="{x:Type Control}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource HelpIcon.Static.Foreground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border Background="Transparent" Padding="2">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource InfoIcon}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource HelpIcon.MouseOver.Foreground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The tooltip a help icon shows -->
    <Style x:Key="HelpToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource HelpToolTip.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HelpToolTip.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource HelpToolTip.Foreground}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16,14">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
