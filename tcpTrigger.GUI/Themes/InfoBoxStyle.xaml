<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A note that explains how something works, shown above the inputs it's about.
         Use: <ContentControl Style="{StaticResource InfoBox}" Content="Text to show"/> -->
    <Style x:Key="InfoBox" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="#0D1724"
                            BorderBrush="#2A4A6B"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12,9">
                        <DockPanel>
                            <!-- "i" icon -->
                            <Viewbox DockPanel.Dock="Left"
                                     Width="18"
                                     Height="18"
                                     Margin="0,1,10,0"
                                     VerticalAlignment="Top">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3"
                                             Canvas.Top="3"
                                             Width="18"
                                             Height="18"
                                             Stroke="#61B8FF"
                                             StrokeThickness="1.8"/>
                                    <Path Data="M12,11 L12,17 M12,7.5 L12,8"
                                          Stroke="#61B8FF"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       Foreground="#E0E0E0"
                                       VerticalAlignment="Top"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>