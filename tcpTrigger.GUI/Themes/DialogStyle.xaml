<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dialog box. Set BorderBrush to the dialog's color.
         Use: <ContentControl Style="{StaticResource DialogBox}" BorderBrush="{StaticResource Dialog.Accent}"> -->
    <Style x:Key="DialogBox" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="340"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dialog.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid>
                        <!-- Shadow. It's its own border behind the dialog box, so the effect doesn't blur the text. -->
                        <Border Background="{StaticResource Dialog.Background}" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24"
                                                  ShadowDepth="8"
                                                  Direction="270"
                                                  Opacity="0.6"
                                                  Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <!-- Border and background. The top padding leaves room for the strip. -->
                        <Border Background="{StaticResource Dialog.Background}"
                                BorderBrush="{StaticResource Dialog.Border}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="4"
                                Padding="0,3,0,0">
                            <ContentPresenter/>
                        </Border>
                        <!-- Strip in the dialog's color across the top -->
                        <Border Height="3"
                                VerticalAlignment="Top"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="4,4,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog heading and message area -->
    <Style x:Key="DialogBody" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="25,25,25,24"/>
    </Style>

    <!-- Dialog footer, which holds the buttons -->
    <Style x:Key="DialogFooter" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ButtonBar.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBar.Border}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0,0,3,3"/>
        <Setter Property="Padding" Value="25,14"/>
    </Style>

    <!-- Trash can icon for the delete dialog, drawn the same way as InfoIcon and WarningIcon -->
    <PathGeometry x:Key="DeleteIcon" Figures="M4,7 L20,7 M10,11 L10,17 M14,11 L14,17 M5,7 L6,20 L18,20 L19,7 M9,7 L9,4 L15,4 L15,7"/>

    <!-- Icon beside the dialog heading. Set Tag to the icon, and Foreground to the dialog's color.
         Use: <ContentControl Style="{StaticResource DialogIcon}" Tag="{StaticResource InfoIcon}" Foreground="{StaticResource Dialog.Accent}"/> -->
    <Style x:Key="DialogIcon" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog heading -->
    <Style x:Key="DialogHeading" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource Dialog.Foreground}"/>
    </Style>

    <!-- Dialog message, below the heading. The left margin lines it up with the heading, past the icon. -->
    <Style x:Key="DialogMessage" TargetType="{x:Type TextBlock}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="30,12,0,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{StaticResource Dialog.Message.Foreground}"/>
    </Style>

    <!-- Dialog buttons, in the footer -->
    <Style x:Key="DialogButtons" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
</ResourceDictionary>
